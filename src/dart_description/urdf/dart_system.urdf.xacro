<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="dart_system">

  <!-- 基地现场偏差，均相对于 base_nominal_link 表达。默认值保持图纸位置不变。 -->
  <xacro:arg name="base_offset_x" default="0.0" />
  <xacro:arg name="base_offset_y" default="0.0" />
  <xacro:arg name="base_offset_z" default="0.0" />
  <xacro:arg name="base_offset_roll" default="0.0" />
  <xacro:arg name="base_offset_pitch" default="0.0" />
  <xacro:arg name="base_offset_yaw" default="0.0" />

  <!-- 场地坐标系：x 右、y 前、z 上 -->
  <!-- 以场地左下角为原点 -->
  <link name="field_link">
    <!-- 薄板顶面与 field_link 的 z=0 平面重合。 -->
    <visual name="field_area">
      <origin
        xyz="7.5 14.0 -0.005"
        rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="15.0 28.0 0.01" />
      </geometry>
      <material name="field_area_material">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
  </link>

  <!-- 图纸中的基地理论坐标系。该变换不由现场标定修改。 -->
  <link name="base_nominal_link" />

  <joint name="field_to_base_nominal" type="fixed">
    <parent link="field_link" />
    <child link="base_nominal_link" />

    <origin xyz="7.5 25.593 0.0" rpy="0.0 0.0 ${pi}" />
  </joint>

  <!-- 现场基地实际坐标系。偏差为零时与理论坐标系重合。 -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://dart_description/meshes/base_link.STL" scale="1 1 1"/>
      </geometry>
      <material name="aluminum_material">
        <color rgba="0.75 0.77 0.80 1.0" />
      </material>
    </visual>
  </link>

  <joint name="base_nominal_to_base" type="fixed">
    <parent link="base_nominal_link" />
    <child link="base_link" />
    <origin
      xyz="$(arg base_offset_x) $(arg base_offset_y) $(arg base_offset_z)"
      rpy="$(arg base_offset_roll) $(arg base_offset_pitch) $(arg base_offset_yaw)" />
  </joint>

  <!-- 滑轨零位，默认在基地左侧 -->
  <link name="rail_origin_link" />

  <joint name="base_to_rail_origin" type="fixed">
    <parent link="base_link" />
    <child link="rail_origin_link" />

    <origin xyz="-0.28 -0.03193 0.91" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- 飞镖检测模块运动位置 -->
  <link name="dart_detection_module_link">
    <visual>
      <geometry>
        <mesh filename="package://dart_description/meshes/dart_detection_module_link.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="dart_detection_module_slide_joint" type="prismatic">
    <parent link="rail_origin_link" />
    <child link="dart_detection_module_link" />
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    <axis xyz="1 0 0" />
    <limit lower="0.0" upper="0.56" effort="1.0" velocity="1.0" />
  </joint>

  <!-- 发光面直径约 55 mm，中心偏移与当前雷达定位配置保持一致。 -->
  <link name="green_light_link"/>

  <joint name="dart_detection_module_to_green_light" type="fixed">
    <parent link="dart_detection_module_link" />
    <child link="green_light_link" />
    <origin xyz="0.0 0.1222 0.02363" rpy="${pi / 9} 0.0 0.0" />
  </joint>

  <!-- 装甲板模块，中心偏移与当前雷达定位配置保持一致。 -->
  <link name="armor_link"/>

  <joint name="dart_detection_module_to_armor" type="fixed">
    <parent link="dart_detection_module_link" />
    <child link="armor_link" />
    <origin xyz="0.0 0.05384 0.10249" rpy="${pi / 3} 0.0 0.0" />
  </joint>

  <!-- 飞镖系统底座坐标系 -->
  <!-- 飞镖系统放置平面投影到底面中心 -->
  <link name="dart_pedestal_link">
    <visual name="dart_pedestal_area">
      <origin xyz="0.0 0.0 0.1025" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="1.0 0.6 0.205" />
      </geometry>
      <material name="dart_pedestal_material">
        <color rgba="0.498 0.498 0.498 1" />
      </material>
    </visual>
  </link>

  <joint name="field_to_dart_pedestal" type="fixed">
    <parent link="field_link" />
    <child link="dart_pedestal_link" />

    <origin xyz="4.23 0.213 0.0" rpy="0.0 0.0 ${pi / 2}" />
  </joint>

  <!-- 镖架机械基准 -->
  <!-- 发射机构旋转轴与飞镖系统放置平面交点 -->
  <link name="dart_base_link">
    <visual>
      <origin xyz="0.0 0.0 0.091" rpy="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="package://dart_description/meshes/dart_link.STL" scale="1 1 1" />
      </geometry>
      <material name="aluminum_material">
        <color rgba="0.75 0.77 0.80 1.0" />
      </material>
    </visual>
  </link>

  <joint name="dart_pedestal_to_base" type="fixed">
    <parent link="dart_pedestal_link" />
    <child link="dart_base_link" />
    <origin
      xyz="0.0 0.0 0.205" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- 发射机构方向 -->
  <!-- 电机上方转盘中心 -->
  <link name="launcher_frame">
    <visual>
      <geometry>
        <mesh filename="package://dart_description/meshes/launcher_frame.STL" scale="1 1 1" />
      </geometry>
      <material name="aluminum_material">
        <color rgba="0.75 0.77 0.80 1.0" />
      </material>
    </visual>
  </link>

  <joint name="launcher_yaw_joint" type="revolute">
    <parent link="dart_base_link" />
    <child link="launcher_frame" />

    <origin xyz="0.0 0.0 0.091" rpy="0.0 0.0 0.0" />
    <axis xyz="0 0 1" />

    <limit lower="${-pi / 2}"
      upper="${pi / 2}"
      effort="20"
      velocity="${10 * pi / 3}" />
  </joint>

  <!-- 飞镖释放坐标 -->
  <link name="dart_release_frame" />

  <joint name="launcher_to_dart_release" type="fixed">
    <parent link="launcher_frame" />
    <child link="dart_release_frame" />

    <origin xyz="0.112 0.0 0.48" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- 相机机械坐标 -->
  <!-- 相机方形安装底面中心 -->
  <link name="camera_mount_link">
    <visual>
      <geometry>
        <mesh filename="package://dart_description/meshes/MV-CA016-10UMUC.STL" scale="1 1 1" />
      </geometry>
      <material name="camera_material">
        <color rgba="0.8 0.8 0.8 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0.012 0.0 0.015" rpy="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="package://dart_description/meshes/MVL-HF5028M-6MPE.STL" scale="1 1 1" />
      </geometry>
      <material name="camera_material">
        <color rgba="0.8 0.8 0.8 1" />
      </material>
    </visual>
  </link>

  <joint name="launcher_to_camera_mount" type="fixed">
    <parent link="launcher_frame" />
    <child link="camera_mount_link" />

    <origin xyz="0.1 0.0 0.8" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- 相机光学坐标 -->
  <link name="camera_optical_frame" />

  <joint name="camera_mount_to_optical" type="fixed">
    <parent link="camera_mount_link" />
    <child link="camera_optical_frame" />

    <!-- camera_mount: x前 y左 z上
         optical:      z前 x右 y下 -->
    <origin xyz="0.04 0.0 0.015" rpy="${-pi / 2} 0.0 ${-pi / 2}" />
  </joint>

  <!-- 雷达机械坐标
       雷达安装底面中心 -->
  <link name="lidar_mount_link">
    <visual>
      <geometry>
        <mesh filename="package://dart_description/meshes/livox_lidar_Mid-70.STL" scale="1 1 1" />
      </geometry>
      <material name="livox_lidar_material">
        <color rgba="0.85 0.87 0.90 1" />
      </material>
    </visual>
  </link>

  <joint name="launcher_to_lidar_mount" type="fixed">
    <parent link="launcher_frame" />
    <child link="lidar_mount_link" />

    <origin xyz="0.35 0.0 0.42" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- 雷达测量坐标系 -->
  <link name="livox_frame" />

  <joint name="lidar_mount_to_livox" type="fixed">
    <parent link="lidar_mount_link" />
    <child link="livox_frame" />

    <origin xyz="0.0323 0.0 0.0324" rpy="0.0 0.0 0.0" />
  </joint>

</robot>
