Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Accumulated1
        - /Filtered1
        - /Base Open Initial1
        - /Base Closed Initial1
        - /Armor Initial1
        - /Base Open Registered1
        - /Base Closed Registered1
        - /Armor Registered1
        - /Markers1
        - /Markers1/Namespaces1
      Splitter Ratio: 0.5
    Tree Height: 437
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
